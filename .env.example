DEBUG=1
DJANGO_SECRET_KEY=seamless-local-dev-secret-key-change-before-deploy

# Leave POSTGRES_HOST and REDIS_URL unset for local SQLite + in-memory Channels.
# Uncomment these when running with Docker Postgres/Redis:
# POSTGRES_HOST=db
# POSTGRES_DB=seamless
# POSTGRES_USER=seamless
# POSTGRES_PASSWORD=seamless
# POSTGRES_PORT=5432
# REDIS_URL=redis://redis:6379

# Must match the Vite customer app origin used for QR stickers.
PUBLIC_BASE_URL=http://localhost:5173
